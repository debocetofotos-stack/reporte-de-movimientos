<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Finanzas diarias | dE BoCETO</title>
  <style>
    :root{--ink:#171717;--wine:#6e2633;--bg:#f4f4f3;--line:#dedede;--muted:#666}*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:Arial,sans-serif;color:var(--ink)}header{background:var(--ink);color:#fff;padding:27px max(20px,calc((100% - 1120px)/2))}h1,h2{font-family:Georgia,serif;font-weight:normal}h1{margin:0;font-size:29px}header p{margin:7px 0 0;color:#ddd}main{max-width:1120px;margin:26px auto;padding:0 20px}.note{margin:0 0 20px;padding:12px 15px;background:#eee8e9;border-left:4px solid var(--wine);font-size:14px}.grid{display:grid;grid-template-columns:390px 1fr;gap:22px;align-items:start}section{background:#fff;border:1px solid var(--line);padding:21px}h2{margin:0 0 17px;font-size:19px}.fields{display:grid;gap:12px}label{display:grid;gap:6px;font-size:13px;font-weight:bold}input,select,textarea,button{font:inherit}input,select,textarea{width:100%;padding:10px;border:1px solid #bbb;background:#fff;border-radius:2px}textarea{min-height:58px;resize:vertical}.two{display:grid;grid-template-columns:1fr 1fr;gap:11px}.two[hidden],label[hidden]{display:none}button{border:0;padding:10px 13px;border-radius:2px;cursor:pointer;font-weight:bold}.primary{background:var(--wine);color:#fff}.secondary{background:#e7e7e7}.danger{background:#f4e3e3;color:#852c2c;padding:4px 7px;font-size:12px}.summary{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px}.card{padding:13px;background:#f7f7f6;border-left:4px solid #999}.income{border-color:#257343}.expense{border-color:#a33a3a}.balance{border-color:var(--wine)}.card span{display:block;font-size:12px;color:var(--muted);margin-bottom:6px}.card strong{font-size:19px}.filters,.actions{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:13px}.filters>*{flex:1 1 140px}.table{overflow:auto}table{border-collapse:collapse;width:100%;min-width:920px;font-size:13px}th,td{padding:10px 7px;text-align:left;border-bottom:1px solid var(--line)}th{color:var(--muted);font-size:11px;text-transform:uppercase}.amount{text-align:right;white-space:nowrap}.tag{display:inline-block;padding:3px 7px;border-radius:15px;font-size:11px}.tag.income{background:#e1f1e8;color:#1b6137}.tag.expense{background:#f6e4e4;color:#8c3232}.tag.transfer{background:#eee8e9;color:#5c2630}.empty{text-align:center;color:var(--muted);padding:22px}@media(max-width:820px){.grid{grid-template-columns:1fr}.summary{grid-template-columns:1fr}.two{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <header><h1>Finanzas diarias</h1><p>Registro de ingresos, gastos, pagos y transferencias.</p></header>
  <main>
    <p class="note">Formato limpio para iniciar octubre de 2026. Los datos se guardan únicamente en este navegador; descarga un CSV como respaldo al cerrar cada mes.</p>
    <div class="grid">
      <section>
        <h2 id="formTitle">Registrar movimiento</h2>
        <form id="form" class="fields">
          <div class="two"><label>Fecha<input id="date" type="date" required></label><label>Tipo<select id="type"><option value="income">Ingreso / abono de cliente</option><option value="expense">Gasto / pago realizado</option><option value="transfer">Transferencia entre cuentas</option></select></label></div>
          <label id="categoryBox">Categoría<select id="category"></select></label>
          <label id="beneficiaryBox">Pagado a / destino<input id="beneficiary" placeholder="Proveedor, colaborador o persona a quien se le pagó"></label>
          <label id="projectBox">Proyecto o cliente al que se aplica<input id="project" placeholder="Ej. 2026-343 Edu Cruz"></label>
          <label>Qué se compró o motivo<input id="description" required placeholder="Ej. 2 tableros de melamina, gasolina o mano de obra"></label>
          <div id="accountBox" class="two"><label>Cuenta o tarjeta<select id="account"></select></label><label>Método de pago<select id="method"><option>Transferencia</option><option>Efectivo</option><option>Tarjeta</option><option>Cheque</option><option>Depósito</option><option>Otro</option></select></label></div>
          <div id="transferBox" class="two" hidden><label>Sale de<select id="fromAccount"></select></label><label>Entra a<select id="toAccount"></select></label></div>
          <label>Monto (Q)<input id="amount" type="number" min="0.01" step="0.01" required placeholder="0.00"></label>
          <label>Comprobante u observación<textarea id="note" placeholder="Factura, transferencia o nota"></textarea></label>
          <button class="primary" id="saveButton">Guardar movimiento</button><button type="button" id="cancelButton" class="secondary" hidden>Cancelar edición</button>
        </form>
      </section>
      <section>
        <h2>Resumen</h2>
        <div class="summary"><div class="card income"><span>Ingresos del período</span><strong id="incomeTotal">Q0.00</strong></div><div class="card expense"><span>Gastos y pagos</span><strong id="expenseTotal">Q0.00</strong></div><div class="card balance"><span>Balance</span><strong id="balanceTotal">Q0.00</strong></div></div>
        <div class="filters"><input id="startDate" type="date" title="Desde"><input id="endDate" type="date" title="Hasta"><select id="typeFilter"><option value="all">Todos los movimientos</option><option value="income">Solo ingresos</option><option value="expense">Solo gastos/pagos</option><option value="transfer">Solo transferencias</option></select><select id="accountFilter"></select><select id="projectFilter"></select><input id="search" placeholder="Buscar"></div>
        <div class="actions"><button type="button" id="exportButton" class="secondary">Descargar CSV</button><button type="button" id="clearFilters" class="secondary">Ver todo</button></div>
        <div class="table"><table><thead><tr><th>Fecha</th><th>Tipo</th><th>Categoría</th><th>Cuenta / recorrido</th><th>Destino / origen</th><th>Proyecto / cliente</th><th>Detalle</th><th>Método</th><th class="amount">Monto</th><th></th></tr></thead><tbody id="rows"></tbody></table></div>
      </section>
    </div>
  </main>
  <script>
    const STORE='deboceto_finanzas_octubre_2026';
    const accounts=['Cuenta 1','Cuenta 2','Tarjeta 1','Tarjeta 2'];
    const categories={income:['Anticipo','Abono de cliente','Pago final','Otro ingreso'],expense:['Materiales','Herrajes','Mano de obra','Transporte','Instalación','Herramientas','Gastos administrativos','Otro gasto']};
    const $=id=>document.getElementById(id);
    const money=value=>new Intl.NumberFormat('es-GT',{style:'currency',currency:'GTQ'}).format(value);
    const localToday=()=>{const d=new Date();d.setMinutes(d.getMinutes()-d.getTimezoneOffset());return d.toISOString().slice(0,10)};
    const escapeHtml=text=>String(text??'').replace(/[&<>"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[char]));
    let movements=JSON.parse(localStorage.getItem(STORE)||'[]');
    let editingId=null;
    function fillAccounts(){['account','fromAccount','toAccount'].forEach(id=>$(id).innerHTML=accounts.map(account=>`<option>${account}</option>`).join(''));$('accountFilter').innerHTML='<option value="">Todas las cuentas y tarjetas</option>'+accounts.map(account=>`<option>${account}</option>`).join('')}
    function setType(){const type=$('type').value;const transfer=type==='transfer';$('categoryBox').hidden=transfer;$('beneficiaryBox').hidden=transfer;$('projectBox').hidden=transfer;$('accountBox').hidden=transfer;$('transferBox').hidden=!transfer;if(!transfer){$('category').innerHTML=categories[type].map(category=>`<option>${category}</option>`).join('');$('beneficiaryBox').childNodes[0].nodeValue=type==='income'?'Recibido de / cliente':'Pagado a / destino'}}
    function refreshProjects(){const selected=$('projectFilter').value;const projects=[...new Set(movements.map(item=>item.project.trim()).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'es'));$('projectFilter').innerHTML='<option value="">Todos los proyectos / clientes</option>'+projects.map(project=>`<option value="${escapeHtml(project)}">${escapeHtml(project)}</option>`).join('');if(projects.includes(selected))$('projectFilter').value=selected}
    function filtered(){const start=$('startDate').value,end=$('endDate').value,type=$('typeFilter').value,account=$('accountFilter').value,project=$('projectFilter').value,query=$('search').value.trim().toLowerCase();return movements.filter(item=>(!start||item.date>=start)&&(!end||item.date<=end)&&(type==='all'||item.type===type)&&(!account||item.account===account||item.fromAccount===account||item.toAccount===account)&&(!project||item.project===project)&&(!query||[item.beneficiary,item.project,item.description,item.category,item.note,item.account,item.fromAccount,item.toAccount].join(' ').toLowerCase().includes(query))).sort((a,b)=>b.date.localeCompare(a.date)||b.created-a.created)}
    function render(){refreshProjects();const list=filtered();const income=list.filter(item=>item.type==='income').reduce((sum,item)=>sum+item.amount,0);const expense=list.filter(item=>item.type==='expense').reduce((sum,item)=>sum+item.amount,0);$('incomeTotal').textContent=money(income);$('expenseTotal').textContent=money(expense);$('balanceTotal').textContent=money(income-expense);$('rows').innerHTML=list.length?list.map(item=>`<tr><td>${item.date.split('-').reverse().join('/')}</td><td><span class="tag ${item.type}">${item.type==='income'?'Ingreso':item.type==='expense'?'Gasto/pago':'Transferencia'}</span></td><td>${item.type==='transfer'?'—':escapeHtml(item.category)}</td><td>${escapeHtml(item.type==='transfer'?item.fromAccount+' → '+item.toAccount:item.account)}</td><td>${escapeHtml(item.type==='transfer'?item.fromAccount+' → '+item.toAccount:item.beneficiary||'—')}</td><td>${escapeHtml(item.project||'—')}</td><td>${escapeHtml(item.description)}</td><td>${escapeHtml(item.type==='transfer'?'—':item.method)}</td><td class="amount">${money(item.amount)}</td><td><button class="secondary" data-edit="${item.id}">Editar</button> <button class="danger" data-delete="${item.id}">Eliminar</button></td></tr>`).join(''):'<tr><td colspan="10" class="empty">Aún no hay movimientos con estos filtros.</td></tr>'}
    function persist(){localStorage.setItem(STORE,JSON.stringify(movements));render()}
    function resetForm(){editingId=null;$('form').reset();$('date').value=localToday();setType();$('formTitle').textContent='Registrar movimiento';$('saveButton').textContent='Guardar movimiento';$('cancelButton').hidden=true}
    $('form').addEventListener('submit',event=>{event.preventDefault();const type=$('type').value;if(type==='transfer'&&$('fromAccount').value===$('toAccount').value)return alert('Elige dos cuentas diferentes.');const previous=movements.find(item=>item.id===editingId);const item={id:editingId||crypto.randomUUID(),created:previous?.created||Date.now(),date:$('date').value,type,category:type==='transfer'?'':$('category').value,beneficiary:type==='transfer'?'':$('beneficiary').value.trim(),project:type==='transfer'?'':$('project').value.trim(),description:$('description').value.trim(),amount:Number($('amount').value),method:type==='transfer'?'':$('method').value,note:$('note').value.trim(),account:type==='transfer'?'':$('account').value,fromAccount:type==='transfer'?$('fromAccount').value:'',toAccount:type==='transfer'?$('toAccount').value:''};if(editingId)movements=movements.map(row=>row.id===editingId?item:row);else movements.push(item);persist();resetForm()});
    $('type').addEventListener('change',setType);['startDate','endDate','typeFilter','accountFilter','projectFilter','search'].forEach(id=>$(id).addEventListener('input',render));
    $('rows').addEventListener('click',event=>{const editId=event.target.dataset.edit,deleteId=event.target.dataset.delete;if(deleteId&&confirm('¿Eliminar este movimiento?')){movements=movements.filter(item=>item.id!==deleteId);persist();return}if(editId){const item=movements.find(row=>row.id===editId);if(!item)return;editingId=editId;$('date').value=item.date;$('type').value=item.type;setType();$('category').value=item.category;$('beneficiary').value=item.beneficiary||'';$('project').value=item.project||'';$('description').value=item.description;$('amount').value=item.amount;$('method').value=item.method||'Transferencia';$('note').value=item.note||'';$('account').value=item.account||accounts[0];$('fromAccount').value=item.fromAccount||accounts[0];$('toAccount').value=item.toAccount||accounts[0];$('formTitle').textContent='Editar movimiento';$('saveButton').textContent='Guardar cambios';$('cancelButton').hidden=false;window.scrollTo({top:0,behavior:'smooth'});}});
    $('cancelButton').addEventListener('click',resetForm);$('clearFilters').addEventListener('click',()=>{$('startDate').value='';$('endDate').value='';$('typeFilter').value='all';$('accountFilter').value='';$('projectFilter').value='';$('search').value='';render()});
    $('exportButton').addEventListener('click',()=>{const headers=['Fecha','Tipo','Categoría','Cuenta o tarjeta','Sale de','Entra a','Destino / origen','Proyecto o cliente','Qué se compró o motivo','Monto','Método','Observación'];const csv=[headers,...filtered().map(item=>[item.date,item.type==='income'?'Ingreso':item.type==='expense'?'Gasto/pago':'Transferencia',item.category,item.account,item.fromAccount,item.toAccount,item.type==='transfer'?item.fromAccount+' → '+item.toAccount:item.beneficiary,item.project,item.description,item.amount,item.method,item.note])].map(row=>row.map(value=>'"'+String(value??'').replaceAll('"','""')+'"').join(',')).join('\n');const link=document.createElement('a');link.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));link.download=`finanzas_dE_BoCETO_${localToday()}.csv`;link.click();URL.revokeObjectURL(link.href)});
    fillAccounts();resetForm();render();
  </script>
</body>
</html>
